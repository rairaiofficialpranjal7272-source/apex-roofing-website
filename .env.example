# Default: private local request inbox only; no messages or emails are sent.
PORT=3000

# Optional live delivery integration (server-only; never use a VITE_ prefix).
# Use a trusted HTTPS receiver accepting multipart form data.
# APPOINTMENT_WEBHOOK_URL=https://your-verified-receiver.example/roofing-requests
# WEBHOOK_TOKEN=replace-with-your-receiver-secret

# Private persistent storage for production (not under public/ or dist/).
# DATA_DIR=/var/data/apex/appointments
